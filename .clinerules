  // SÉPARER : lance le job (simulé tant que les modèles ne sont pas branchés) et charge les stems.

  async function separate() {

    if (!trackPath) return;

    error = null;

    cancelStatus = null;

    separating = true;

    const t0 = Date.now();

    try {

      // Exécuter l'inférence localement selon le mode choisi (performance ou studio)

      const buffer = new Float32Array(44100);

      const channels = [

        new Float32Array(buffer.length),

        new Float32Array(buffer.length),

      ];

      let result;

      if (qualityMode === 'studio') {

        result = runStudioInference(channels, track?.sampleRate ?? 44100);

      } else {

        result = runPerformanceInference(channels, track?.sampleRate ?? 44100);

      }

      job = {

        jobId: 'local-' + Date.now(),

        simulated: true,

        bytesPerStem: 0,

      };

      await loadStems(job.jobId);

      lastMs = Date.now() - t0;

      // Les stems sont prêts : on bascule sur l'onglet de séparation.

      activeTab = 'separation';

    } catch (e) {

      error = messageOf(e);

    } finally {

      separating = false;

    }

  }



  // Choix du modèle (zone IA) : mémorisé avec les réglages, utilisé quand l'inférence réelle sera branchée.

  function selectModel(id: string) {

    selectedModel = id;

    tauriInvoke('set_selected_model', { model: id }).catch((err) => {

      console.warn('Choix du modèle non enregistré:', err);

    });

  }



  // Export des stems cochés du job courant, après le contrôle d'espace fait par ExportDialog (FR-018).

  async function exportStems(stems: StemId[]) {

    if (!job) return;

    error = null;

    try {

      const result = await tauriInvoke<{ paths: string[] }>('export_stems', { jobId: job.jobId, stems });

      exportedPaths = result.paths;

      exportOpen = false;

    } catch (e) {

      error = messageOf(e);

    }

  }



  // Annulation du job courant : l'export n'est plus proposé (le backend refuse avec CANCELLED).

  async function cancelJob() {

    if (!job) return;

    error = null;

    try {

      await tauriInvoke('cancel_separation', { jobId: job.jobId });

      resetStems();

      job = null;

      exportOpen = false;

      cancelStatus = 'Séparation annulée.';

    } catch (e) {

      error = messageOf(e);

    }

  }

</script>



