{
  "$schema": "https://apps.tauri.dev/schema.json",
  "productName": "AlcheMix Studio",
  "version": "0.1.0",
  "identifier": "studio.alchemix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AlcheMix Studio",
        "width": 1920,
        "height": 1080,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png"
    ]
  }
}
